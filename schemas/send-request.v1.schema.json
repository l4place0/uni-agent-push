{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uni-push.local/schemas/send-request.v1.schema.json",
  "title": "Uni Push send request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notification_id",
    "destination",
    "message",
    "policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "notification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "enum": ["target", "channel"]
        },
        "name": {
          "$ref": "#/$defs/configuredName"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "body", "format", "priority"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "format": {
          "enum": ["plain", "markdown"]
        },
        "priority": {
          "enum": ["low", "normal", "high", "critical"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://"
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["single", "fallback", "broadcast"]
        }
      }
    }
  },
  "$defs": {
    "configuredName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
    }
  }
}
