{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uni-push.local/schemas/config.v1.schema.json",
  "title": "Uni Push configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "connections", "channels", "targets"],
  "properties": {
    "version": {
      "const": 1
    },
    "connections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/configuredName"
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/qqConnection" },
          { "$ref": "#/$defs/telegramConnection" },
          { "$ref": "#/$defs/serverChanConnection" },
          { "$ref": "#/$defs/smtpConnection" }
        ]
      }
    },
    "channels": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/configuredName"
      },
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/qqChannel" },
          { "$ref": "#/$defs/telegramChannel" },
          { "$ref": "#/$defs/serverChanChannel" },
          { "$ref": "#/$defs/smtpChannel" }
        ]
      }
    },
    "targets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/configuredName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "configuredName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
    },
    "secretReference": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "oneOf": [
        {
          "pattern": "^env:[A-Z_][A-Z0-9_]*$"
        },
        {
          "pattern": "^store:[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
        },
        {
          "pattern": "^keychain:[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$"
        }
      ]
    },
    "connectionName": {
      "$ref": "#/$defs/configuredName"
    },
    "emailAddress": {
      "type": "string",
      "format": "email",
      "maxLength": 320,
      "pattern": "^[\\x00-\\x7F]+$"
    },
    "qqConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "app_id", "client_secret"],
      "properties": {
        "provider": { "const": "qqbot" },
        "app_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "client_secret": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "telegramConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "token"],
      "properties": {
        "provider": { "const": "telegram" },
        "token": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "serverChanConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "send_key"],
      "properties": {
        "provider": { "const": "serverchan" },
        "send_key": {
          "$ref": "#/$defs/secretReference"
        }
      }
    },
    "smtpConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "host",
        "port",
        "security",
        "username",
        "password",
        "from"
      ],
      "properties": {
        "provider": { "const": "smtp" },
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "security": {
          "enum": ["tls", "starttls"]
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "password": {
          "$ref": "#/$defs/secretReference"
        },
        "from": {
          "$ref": "#/$defs/emailAddress"
        },
        "from_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\r\\n]+$"
        }
      }
    },
    "qqChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "connection", "target"],
      "properties": {
        "provider": { "const": "qqbot" },
        "connection": { "$ref": "#/$defs/connectionName" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "openid"],
          "properties": {
            "type": { "enum": ["group", "user"] },
            "openid": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "not": { "pattern": "^[0-9]+$" }
            }
          }
        }
      }
    },
    "telegramChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "connection", "chat_id"],
      "properties": {
        "provider": { "const": "telegram" },
        "connection": { "$ref": "#/$defs/connectionName" },
        "chat_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:-?[0-9]+|@[A-Za-z][A-Za-z0-9_]{4,31})$"
        },
        "message_thread_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "disable_link_preview": {
          "type": "boolean"
        },
        "silent": {
          "type": "boolean"
        },
        "protect_content": {
          "type": "boolean"
        }
      }
    },
    "serverChanChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "connection"],
      "properties": {
        "provider": { "const": "serverchan" },
        "connection": { "$ref": "#/$defs/connectionName" },
        "delivery_channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[^|\\r\\n]+$"
          }
        },
        "hide_caller_ip": {
          "type": "boolean"
        }
      }
    },
    "smtpChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "connection", "to"],
      "properties": {
        "provider": { "const": "smtp" },
        "connection": { "$ref": "#/$defs/connectionName" },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/emailAddress"
          }
        },
        "cc": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/emailAddress"
          }
        },
        "bcc": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/emailAddress"
          }
        },
        "reply_to": {
          "$ref": "#/$defs/emailAddress"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "policy"],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/configuredName"
          }
        },
        "policy": {
          "enum": ["single", "fallback", "broadcast"]
        }
      }
    }
  }
}
