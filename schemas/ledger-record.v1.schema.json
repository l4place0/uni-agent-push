{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uni-push.local/schemas/ledger-record.v1.schema.json",
  "title": "Uni Push normalized idempotency ledger record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "notification_id",
    "request_fingerprint",
    "route_fingerprint",
    "delivery_policy",
    "state",
    "phase",
    "planned_attempts",
    "next_attempt_index",
    "attempts",
    "recovery_count",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "notification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "request_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "route_fingerprint": { "$ref": "#/$defs/fingerprint" },
    "delivery_policy": {
      "enum": ["single", "fallback", "broadcast"]
    },
    "state": { "enum": ["in_progress", "terminal"] },
    "phase": {
      "enum": ["claimed", "dispatching", "between_attempts", "complete"]
    },
    "planned_attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/plannedAttempt" }
    },
    "next_attempt_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "attempts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "delivery-receipt.v1.schema.json#/$defs/attempt"
      }
    },
    "active_attempt": { "$ref": "#/$defs/activeAttempt" },
    "receipt": {
      "$ref": "delivery-receipt.v1.schema.json#/$defs/deliveryReceipt"
    },
    "recovery_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "terminal" } },
        "required": ["state"]
      },
      "then": {
        "required": ["receipt", "completed_at", "expires_at"],
        "properties": { "phase": { "const": "complete" } },
        "not": { "required": ["active_attempt"] }
      },
      "else": {
        "properties": {
          "phase": {
            "enum": ["claimed", "dispatching", "between_attempts"]
          }
        },
        "not": {
          "anyOf": [
            { "required": ["receipt"] },
            { "required": ["completed_at"] },
            { "required": ["expires_at"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "phase": { "const": "dispatching" } },
        "required": ["phase"]
      },
      "then": { "required": ["active_attempt"] },
      "else": { "not": { "required": ["active_attempt"] } }
    }
  ],
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuredName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)*$"
    },
    "provider": {
      "enum": ["qqbot", "telegram", "serverchan", "smtp"]
    },
    "transformations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "markdown_to_plain",
          "title_prefixed_to_body",
          "url_appended_to_body",
          "tags_omitted",
          "summary_omitted",
          "markdown_to_provider_html",
          "markdown_image_to_link",
          "markdown_to_email_multipart"
        ]
      }
    },
    "plannedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "provider", "acceptance_scope"],
      "properties": {
        "channel": { "$ref": "#/$defs/configuredName" },
        "provider": { "$ref": "#/$defs/provider" },
        "acceptance_scope": {
          "enum": ["provider_api_only", "smtp_relay_only"]
        }
      },
      "allOf": [{ "$ref": "#/$defs/providerScopeRule" }]
    },
    "activeAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "provider",
        "acceptance_scope",
        "transformations"
      ],
      "properties": {
        "channel": { "$ref": "#/$defs/configuredName" },
        "provider": { "$ref": "#/$defs/provider" },
        "acceptance_scope": {
          "enum": ["provider_api_only", "smtp_relay_only"]
        },
        "transformations": { "$ref": "#/$defs/transformations" }
      },
      "allOf": [{ "$ref": "#/$defs/providerScopeRule" }]
    },
    "providerScopeRule": {
      "if": {
        "type": "object",
        "properties": { "provider": { "const": "smtp" } },
        "required": ["provider"]
      },
      "then": {
        "type": "object",
        "properties": {
          "acceptance_scope": { "const": "smtp_relay_only" }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "acceptance_scope": { "const": "provider_api_only" }
        }
      }
    }
  }
}
